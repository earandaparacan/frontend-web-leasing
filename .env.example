# URL privada del backend Django, accesible desde el servidor de Next.js.
BACKEND_URL=http://127.0.0.1:8000

# URL del backend vista desde Docker Compose. El valor predeterminado apunta
# al host donde se ejecuta Docker; cambiarlo por http://backend:8000 si ambos
# servicios forman parte del mismo Compose.
DOCKER_BACKEND_URL=http://host.docker.internal:8000

# Puerto publicado por Docker Compose para la aplicación web.
WEB_PORT=3000

# Las credenciales de Headwind MDM se configuran únicamente en el .env de Django.
# Nunca deben declararse como variables públicas de Next.js.
