# URL privada del backend Django, accesible desde el servidor de Next.js.
BACKEND_URL=http://127.0.0.1:8000

# Opción A: servicio Flask MDM existente. Estas variables solo se leen en el servidor.
MDM_BACKEND_URL=http://127.0.0.1:5000
MDM_BACKEND_USER=usuario_del_panel_mdm
MDM_BACKEND_PASSWORD=contrasena_del_panel_mdm

# Opcional. Con MDM_BACKEND_URL se usan /api/query y /api/action por defecto.
# Sin MDM_BACKEND_URL se usa BACKEND_URL con /api/v1/mdm/devices/query y
# /api/v1/mdm/devices/action, reenviando la sesión y el CSRF de Django.
# MDM_QUERY_PATH=/api/query
# MDM_ACTION_PATH=/api/action
